{
    "name": "Python Development (Copilot & GitFlow)",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.black-formatter",
                "ms-python.mypy-type-checker",
                "formulahendry.code-runner",
                "DavidAnson.vscode-markdownlint",
                "yzhang.markdown-all-in-one",
                "GitHub.copilot",
                "GitHub.copilot-chat"
            ],
            "settings": {
                // Python 인터프리터 경로 설정 (자동 감지)
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                // Black을 기본 Python 포맷터로 설정
                "[python]": {
                    "editor.defaultFormatter": "ms-python.black-formatter",
                    "editor.formatOnSave": false
                },
                // Code Runner 설정: 실행 시 터미널을 사용하도록 설정 (입력값 처리 가능)
                "code-runner.runInTerminal": true,
                "code-runner.saveFileBeforeRun": true,
                // Python 파일 실행 설정
                "code-runner.executorMap": {
                    "python": "python3 -u"
                },
                // Pylance 설정: 엄격한 타입 체킹
                "python.analysis.typeCheckingMode": "strict",
                "python.analysis.autoImportCompletions": true,
                "python.analysis.diagnosticMode": "workspace",
                "python.analysis.stubPath": "./typings",
                // 부분 타입 힌트 및 사용되지 않는 변수 체크
                "python.analysis.diagnosticSeverityOverrides": {
                    "reportMissingParameterType": "error",
                    "reportMissingTypeArgument": "error",
                    "reportUnknownParameterType": "error",
                    "reportUnusedVariable": "error"
                },
                // mypy 타입 체커 설정: 에디터에서 실시간 타입 체킹
                "mypy-type-checker.enabled": true,
                "mypy-type-checker.reportingScope": "workspace"
            }
        }
    },
    "remoteUser": "root"
}